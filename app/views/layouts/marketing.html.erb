<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title><%= content_for(:title) || "Devbisect - Modern Rails Application" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || 'A modern Rails 8 application with PostgreSQL, Devise, Tailwind CSS, and Flowbite components' %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "inter-font" %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="flowbite" class="antialiased">
    <!-- Marketing Navigation -->
    <nav class="bg-[#F4F2FD]/95 backdrop-blur-sm border-b border-gray-200 fixed w-full z-50">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-between h-[62px]">
          
          <!-- Logo -->
          <div class="flex-shrink-0">
            <%= link_to root_path, class: "flex items-center space-x-2.5 group" do %>
              <div class="relative w-7 h-7">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="9" height="9" rx="1.5" fill="#8B5CF6"/>
                  <rect x="13" y="2" width="9" height="9" rx="1.5" fill="#A78BFA"/>
                  <rect x="2" y="13" width="9" height="9" rx="1.5" fill="#6366F1"/>
                  <rect x="13" y="13" width="9" height="9" rx="1.5" fill="#818CF8"/>
                </svg>
              </div>
              <span class="text-lg font-semibold tracking-[-0.01em] text-gray-900">Auregon</span>
            <% end %>
          </div>

          <!-- Desktop Navigation - Centered -->
          <div class="hidden lg:flex items-center justify-center flex-1">
            <div class="flex items-center space-x-6">
              <!-- Home -->
              <div class="relative group">
                <%= link_to root_path, class: "inline-flex items-center gap-1 px-1 py-2 text-[13px] font-medium text-indigo-600" do %>
                  <span>Home</span>
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                <% end %>
              </div>
              
              <!-- Pages Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-1 px-2 py-2 text-[13px] font-medium text-gray-800 hover:text-gray-900 transition-colors duration-200">
                  <span>Pages</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">About Us</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Team</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Careers</a>
                    <a href="#pricing" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Pricing</a>
                  </div>
                </div>
              </div>

              <!-- Services Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-1 px-2 py-2 text-[13px] font-medium text-gray-800 hover:text-gray-900 transition-colors duration-200">
                  <span>Services</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">AI Consulting</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Machine Learning</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Data Analytics</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Automation</a>
                  </div>
                </div>
              </div>

              <!-- Projects Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-1 px-2 py-2 text-[13px] font-medium text-gray-800 hover:text-gray-900 transition-colors duration-200">
                  <span>Projects</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    <a href="#projects" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">All Projects</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Case Studies</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Portfolio</a>
                  </div>
                </div>
              </div>

              <!-- Blog Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-1 px-2 py-2 text-[13px] font-medium text-gray-800 hover:text-gray-900 transition-colors duration-200">
                  <span>Blog</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Latest Posts</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">AI Insights</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Tech News</a>
                  </div>
                </div>
              </div>

              <!-- Contact -->
              <a href="#contact" class="px-2 py-2 text-[13px] font-medium text-gray-800 hover:text-gray-900 transition-colors duration-200">Contact</a>
            </div>
          </div>

          <!-- Right Side Actions -->
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <!-- User Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-2 px-3 py-2 text-sm font-medium text-gray-700 hover:text-indigo-600 transition-colors duration-200 rounded-lg hover:bg-gray-50">
                  <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-semibold">
                    <%= current_user.email.first.upcase %>
                  </div>
                </button>
                <div class="absolute right-0 mt-2 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    <%= link_to dashboard_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" do %>
                      Dashboard
                    <% end %>
                    <%= link_to edit_user_registration_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" do %>
                      Profile
                    <% end %>
                    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" do %>
                      Sign Out
                    <% end %>
                  </div>
                </div>
              </div>
            <% else %>
              <!-- Get Started Button -->
              <div class="flex items-center space-x-3">
                <%= link_to new_user_registration_path, class: "hidden lg:inline-flex items-center px-7 py-2.5 text-white text-sm font-semibold rounded-xl transition-all duration-200 shadow-[0_8px_20px_rgba(99,102,241,0.25)]", style: "background: linear-gradient(90deg, #8B5CF6 0%, #60A5FA 100%);" do %>
                  Get Started
                <% end %>
                
                <!-- Bot Icon -->
                <button class="flex h-10 w-10 items-center justify-center rounded-full border border-indigo-200 bg-[#F4F2FD] text-indigo-500 transition-colors duration-200 hover:bg-white">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect x="6" y="8" width="12" height="9" rx="3" stroke-width="2"/>
                    <path d="M12 5v3M9.5 12h.01M14.5 12h.01" stroke-linecap="round" stroke-width="2"/>
                  </svg>
                </button>
              </div>
            <% end %>

            <!-- Mobile Menu Button -->
            <button class="lg:hidden p-2 hover:bg-gray-100 rounded-lg transition-colors duration-200" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
              <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden lg:hidden pb-4">
          <div class="flex flex-col space-y-2">
            <%= link_to "Home", root_path, class: "px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg" %>
            <a href="#" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Pages</a>
            <a href="#" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Services</a>
            <a href="#projects" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Projects</a>
            <a href="#" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Blog</a>
            <a href="#contact" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Contact</a>
            <% unless user_signed_in? %>
              <%= link_to "Get Started", new_user_registration_path, class: "px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg text-center" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <!-- Flash Messages -->
    <% if notice || alert %>
      <div class="fixed top-20 right-4 z-50 space-y-2">
        <% if notice %>
          <div class="alert alert-success shadow-lg max-w-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span><%= notice %></span>
          </div>
        <% end %>

        <% if alert %>
          <div class="alert alert-error shadow-lg max-w-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m2 2l-2-2m0 0l2-2m-2 2l-2 2" /></svg>
            <span><%= alert %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="pt-16">
      <%= yield %>
    </main>

    <!-- Footer -->
    <footer class="footer footer-center p-10 bg-base-200 text-base-content mt-20">
      <nav class="grid grid-flow-col gap-4">
        <a class="link link-hover">About</a>
        <a class="link link-hover">Contact</a>
        <a class="link link-hover">Privacy Policy</a>
        <a class="link link-hover">Terms of Service</a>
      </nav>
      <nav>
        <div class="grid grid-flow-col gap-4">
          <a href="#" class="btn btn-ghost btn-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="fill-current"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"></path></svg>
          </a>
          <a href="#" class="btn btn-ghost btn-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="fill-current"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"></path></svg>
          </a>
          <a href="#" class="btn btn-ghost btn-circle">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" class="fill-current"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"></path></svg>
          </a>
        </div>
      </nav>
      <aside>
        <p>Copyright © <%= Time.current.year %> - Devbisect. All rights reserved.</p>
      </aside>
    </footer>
  </body>
</html>
