<div class="px-6 py-12">
  <!-- Header -->
  <div class="mb-12">
    <h1 class="text-4xl font-bold mb-4">Devbisect</h1>
    <p class="text-xl text-gray-600">Rails 8 with Flowbite & Daisy UI Components</p>
  </div>

  <!-- Daisy UI Components -->
  <div class="mb-12">
    <h2 class="text-2xl font-semibold mb-6">Daisy UI Components</h2>
    
    <!-- Buttons -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Buttons</h3>
      <div class="flex gap-4 flex-wrap">
        <button class="btn btn-primary">Primary</button>
        <button class="btn btn-secondary">Secondary</button>
        <button class="btn btn-success">Success</button>
        <button class="btn btn-warning">Warning</button>
        <button class="btn btn-error">Error</button>
      </div>
    </div>

    <!-- Cards -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Cards</h3>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">Card 1</h2>
            <p>This is a Daisy UI card component</p>
            <div class="card-actions justify-end">
              <button class="btn btn-primary">Learn more</button>
            </div>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">Card 2</h2>
            <p>Fully styled with Daisy UI</p>
            <div class="card-actions justify-end">
              <button class="btn btn-primary">Learn more</button>
            </div>
          </div>
        </div>
        <div class="card bg-base-100 shadow-xl">
          <div class="card-body">
            <h2 class="card-title">Card 3</h2>
            <p>No extra CSS needed</p>
            <div class="card-actions justify-end">
              <button class="btn btn-primary">Learn more</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Badge -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Badge & Pills</h3>
      <div class="flex gap-4 flex-wrap">
        <div class="badge">Default</div>
        <div class="badge badge-primary">Primary</div>
        <div class="badge badge-secondary">Secondary</div>
        <div class="badge badge-success">Success</div>
      </div>
    </div>
  </div>

  <!-- Flowbite Components -->
  <div class="mb-12">
    <h2 class="text-2xl font-semibold mb-6">Flowbite Components</h2>
    
    <!-- Alert -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Alerts</h3>
      <div id="alert-border-1" class="p-4 mb-4 text-blue-800 border-t-4 border-blue-300 bg-blue-50 dark:text-blue-400 dark:bg-gray-800 dark:border-blue-800" role="alert">
        <p class="font-bold">Info alert</p>
        <div class="text-sm">This is a Flowbite alert component</div>
      </div>
      <div id="alert-border-2" class="p-4 mb-4 text-green-800 border-t-4 border-green-300 bg-green-50 dark:text-green-400 dark:bg-gray-800 dark:border-green-800" role="alert">
        <p class="font-bold">Success alert</p>
        <div class="text-sm">Operation completed successfully</div>
      </div>
    </div>

    <!-- Dropdown -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Dropdown Menu</h3>
      <button id="dropdownDefaultButton" data-dropdown-toggle="dropdown" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center inline-flex items-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" type="button">
        Dropdown menu 
        <svg class="w-2.5 h-2.5 ms-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
        </svg>
      </button>

      <div id="dropdown" class="z-10 hidden bg-white divide-y divide-gray-100 rounded-lg shadow w-44 dark:bg-gray-700 dark:divide-gray-600">
        <ul class="py-2 text-sm text-gray-700 dark:text-gray-200" aria-labelledby="dropdownDefaultButton">
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Dashboard</a>
          </li>
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Settings</a>
          </li>
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Earnings</a>
          </li>
          <li>
            <a href="#" class="block px-4 py-2 hover:bg-gray-100 dark:hover:bg-gray-600 dark:hover:text-white">Sign out</a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Modal -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Modal</h3>
      <button data-modal-target="default-modal" data-modal-toggle="default-modal" class="block text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800" type="button">
        Open modal
      </button>

      <div id="default-modal" tabindex="-1" aria-hidden="true" class="hidden overflow-y-auto overflow-x-hidden fixed top-0 right-0 left-0 z-50 justify-center items-center w-full md:inset-0 h-[calc(100%-1rem)] max-h-full">
        <div class="relative p-4 w-full max-w-2xl max-h-full">
          <div class="relative bg-white rounded-lg shadow dark:bg-gray-700">
            <div class="flex items-center justify-between p-4 md:p-5 border-b rounded-t dark:border-gray-600">
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                Flowbite Modal Component
              </h3>
              <button type="button" class="text-gray-400 bg-transparent hover:bg-gray-200 hover:text-gray-900 rounded-lg text-sm w-8 h-8 ms-auto inline-flex justify-center items-center dark:hover:bg-gray-600 dark:hover:text-white" data-modal-hide="default-modal">
                <svg class="w-3 h-3" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
              </button>
            </div>
            <div class="p-4 md:p-5 space-y-4">
              <p class="text-base leading-relaxed text-gray-500 dark:text-gray-400">
                With Flowbite's modal, you get all the JavaScript functionality built-in. No manual JS required!
              </p>
              <p class="text-base leading-relaxed text-gray-500 dark:text-gray-400">
                This modal will close when you click the close button or the button below.
              </p>
            </div>
            <div class="flex items-center p-4 md:p-5 border-t border-gray-200 rounded-b dark:border-gray-600">
              <button data-modal-hide="default-modal" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 text-center dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800">I accept</button>
              <button data-modal-hide="default-modal" type="button" class="py-2.5 px-5 ms-3 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100 dark:focus:ring-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700">Decline</button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Accordion -->
    <div class="mb-8">
      <h3 class="text-lg font-semibold mb-4">Accordion</h3>
      <div id="accordion-example">
        <h2 id="accordion-heading-1">
          <button type="button" class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border border-b-0 border-gray-200 rounded-t-xl focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-800 dark:border-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 gap-3" data-accordion-target="#accordion-body-1" aria-expanded="true" aria-controls="accordion-body-1">
            <span>What is Flowbite?</span>
            <svg data-accordion-icon class="w-6 h-6 rotate-0 shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
          </button>
        </h2>
        <div id="accordion-body-1" class="hidden" aria-labelledby="accordion-heading-1">
          <div class="p-5 border border-b-0 border-gray-200 dark:border-gray-700 dark:bg-gray-900">
            <p class="mb-2 text-gray-500 dark:text-gray-400">Flowbite is an open-source library of interactive components built on top of Tailwind CSS</p>
          </div>
        </div>
        <h2 id="accordion-heading-2">
          <button type="button" class="flex items-center justify-between w-full p-5 font-medium rtl:text-right text-gray-500 border border-b-0 border-gray-200 focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-800 dark:border-gray-700 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-800 gap-3" data-accordion-target="#accordion-body-2" aria-expanded="false" aria-controls="accordion-body-2">
            <span>How to get started?</span>
            <svg data-accordion-icon class="w-6 h-6 rotate-0 shrink-0" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"></path></svg>
          </button>
        </h2>
        <div id="accordion-body-2" class="hidden" aria-labelledby="accordion-heading-2">
          <div class="p-5 border border-b-0 border-gray-200 dark:border-gray-700">
            <p class="mb-2 text-gray-500 dark:text-gray-400">Copy and paste the component code into your project.</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Getting Started -->
  <div class="bg-blue-50 dark:bg-gray-900 border border-blue-200 dark:border-gray-700 rounded-lg p-6">
    <h2 class="text-2xl font-semibold mb-4">Getting Started</h2>
    <ul class="space-y-2 text-gray-700 dark:text-gray-300">
      <li>✅ <strong>Daisy UI</strong> - Included as Tailwind plugin with pre-built components</li>
      <li>✅ <strong>Flowbite</strong> - JavaScript functionality auto-initializes on page load and Turbo navigation</li>
      <li>✅ <strong>No manual JS</strong> - All interactive components work automatically</li>
      <li>✅ <strong>UUID Primary Keys</strong> - All models use UUID as primary key</li>
      <li>✅ <strong>PostgreSQL</strong> - Database configured and ready</li>
      <li>✅ <strong>Devise Authentication</strong> - User authentication configured</li>
    </ul>
    <div class="mt-6 flex gap-4">
      <a href="https://daisyui.com/" target="_blank" class="btn btn-primary">Daisy UI Docs</a>
      <a href="https://flowbite.com/" target="_blank" class="btn btn-secondary">Flowbite Docs</a>
    </div>
  </div>
</div>
