<div class="relative min-h-screen overflow-hidden bg-[linear-gradient(180deg,#f3f1fd_0%,#eeecfb_52%,#ece9fa_100%)]">
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 left-[11%] h-full w-px bg-gradient-to-b from-transparent via-indigo-200/35 to-transparent"></div>
    <div class="absolute top-0 right-[11%] h-full w-px bg-gradient-to-b from-transparent via-indigo-200/35 to-transparent"></div>
  </div>

  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute left-1/2 top-[17%] -translate-x-1/2 h-[560px] w-[560px] sm:h-[680px] sm:w-[680px] lg:h-[760px] lg:w-[760px] rounded-full border border-indigo-300/20"></div>
    <div class="absolute left-1/2 top-[22%] -translate-x-1/2 h-[440px] w-[440px] sm:h-[560px] sm:w-[560px] lg:h-[620px] lg:w-[620px] rounded-full border border-indigo-300/20"></div>
    <div class="absolute left-1/2 top-[29%] -translate-x-1/2 h-[340px] w-[340px] sm:h-[420px] sm:w-[420px] lg:h-[470px] lg:w-[470px] rounded-full border border-indigo-300/15"></div>

    <div class="absolute left-1/2 top-[24%] -translate-x-1/2 h-[360px] w-[360px] sm:h-[460px] sm:w-[460px] lg:h-[520px] lg:w-[520px] rounded-full bg-[radial-gradient(circle_at_50%_28%,rgba(129,140,248,0.28),rgba(167,139,250,0.18)_42%,rgba(229,231,255,0.10)_72%,transparent_100%)]"></div>
    <div class="absolute left-1/2 top-[29%] -translate-x-1/2 h-[260px] w-[260px] sm:h-[330px] sm:w-[330px] lg:h-[380px] lg:w-[380px] rounded-full bg-[radial-gradient(circle_at_50%_30%,rgba(129,140,248,0.18),rgba(199,210,254,0.14)_45%,rgba(243,244,255,0.08)_78%,transparent_100%)]"></div>

    <div class="absolute left-[24%] top-[18.2%] h-2.5 w-2.5 rounded-full bg-indigo-300/70"></div>
    <div class="absolute right-[24%] top-[30.5%] h-2.5 w-2.5 rounded-full bg-indigo-200/80"></div>
    <div class="absolute left-[35%] top-[42.2%] h-2 w-2 rounded-full bg-indigo-500/85"></div>
    <div class="absolute left-[6%] top-[7%] h-2 w-2 rounded-full bg-indigo-500/85"></div>
  </div>

  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute left-[7.2%] top-[53%] h-[180px] w-px bg-gradient-to-b from-indigo-200/55 to-transparent"></div>
    <div class="absolute right-[7.2%] top-[53%] h-[180px] w-px bg-gradient-to-b from-indigo-200/55 to-transparent"></div>

    <div class="absolute left-[5.5%] top-[54%] hidden md:flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-[0_8px_28px_rgba(99,102,241,0.08)] animate-pulse">
      <svg class="h-8 w-8 text-sky-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
      </svg>
    </div>

    <div class="absolute right-[5.5%] top-[54%] hidden md:flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-[0_8px_28px_rgba(99,102,241,0.08)] animate-pulse">
      <svg class="h-8 w-8 text-sky-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
      </svg>
    </div>

    <div class="absolute left-[19.5%] top-[68%] hidden sm:flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-[0_8px_28px_rgba(99,102,241,0.08)] animate-pulse">
      <div class="flex items-center -space-x-2">
        <span class="h-6 w-6 rounded-full bg-sky-400"></span>
        <span class="h-6 w-6 rounded-full bg-orange-500"></span>
      </div>
    </div>

    <div class="absolute right-[19.5%] top-[68%] hidden sm:flex h-16 w-16 items-center justify-center rounded-full bg-white shadow-[0_8px_28px_rgba(99,102,241,0.08)] animate-pulse">
      <svg class="h-8 w-8 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
      </svg>
    </div>
  </div>

  <section class="relative z-10 flex min-h-screen items-center justify-center px-4 sm:px-6 pt-24 pb-10 sm:pb-12">
    <div class="mx-auto w-full max-w-4xl text-center">
      <h1 class="mx-auto max-w-[16ch] text-[clamp(2.6rem,11.5vw,4.2rem)] font-semibold leading-[1.04] tracking-[-0.035em] text-black/90">
        AI solutions that adapt and
        <span class="block text-gray-600/85">Grow with your business</span>
      </h1>

      <p class="mx-auto mt-6 max-w-3xl text-[15px] sm:text-lg leading-relaxed text-gray-500 px-1 sm:px-0">
        We develop enterprise-ready AI systems that optimize workflows, surface
        meaningful insights, and drive confident growth.
      </p>

      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:gap-4 sm:flex-row">
        <% if user_signed_in? %>
          <%= link_to dashboard_path, class: "inline-flex items-center justify-center gap-2 rounded-xl px-8 sm:px-10 py-3.5 text-sm font-semibold text-white shadow-[0_8px_22px_rgba(99,102,241,0.35)] min-w-[220px] bg-[linear-gradient(90deg,#8b5cf6_0%,#60a5fa_100%)]" do %>
            <span>Go to Dashboard</span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          <% end %>
        <% else %>
          <%= link_to new_user_registration_path, class: "inline-flex items-center justify-center gap-2 rounded-xl px-8 sm:px-10 py-3.5 text-sm font-semibold text-white shadow-[0_8px_22px_rgba(99,102,241,0.35)] min-w-[220px] bg-[linear-gradient(90deg,#8b5cf6_0%,#60a5fa_100%)]" do %>
            <span>Get in touch</span>
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          <% end %>
        <% end %>

        <%= link_to "#projects", class: "inline-flex items-center justify-center rounded-xl border border-indigo-200 bg-transparent px-8 sm:px-10 py-3.5 text-sm font-semibold text-gray-800 min-w-[220px]" do %>
          Explore the Project
        <% end %>
      </div>

      <div class="mt-16 sm:mt-24 lg:mt-28">
        <p class="text-xs font-semibold uppercase tracking-[0.14em] text-gray-500/80">
          <span class="mr-1 text-indigo-500">•</span> TRUST BY 120+ BUSINESSES
        </p>

        <div class="relative mt-7 overflow-hidden" data-controller="logo-marquee" data-action="mouseenter->logo-marquee#pause mouseleave->logo-marquee#resume">
          <div data-logo-marquee-target="track" class="flex w-max items-center whitespace-nowrap py-2 will-change-transform">
            <div data-logo-marquee-target="group" class="inline-flex items-center gap-10 sm:gap-12 pr-10 sm:pr-12 text-[15px] sm:text-base font-semibold text-gray-400/85">
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105">Raycast</span>
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105">runway</span>
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105 tracking-[0.22em]">MERCURY</span>
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105">Retool</span>
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105">remote</span>
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105 tracking-[0.24em]">ARC</span>
            </div>
            <div aria-hidden="true" class="inline-flex items-center gap-10 sm:gap-12 pr-10 sm:pr-12 text-[15px] sm:text-base font-semibold text-gray-400/85">
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105">Raycast</span>
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105">runway</span>
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105 tracking-[0.22em]">MERCURY</span>
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105">Retool</span>
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105">remote</span>
              <span class="cursor-pointer transition duration-200 hover:text-indigo-500 hover:scale-105 tracking-[0.24em]">ARC</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>
