# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Rails Environment
RAILS_ENV=development
RAILS_LOG_TO_STDOUT=true

# Session & Security
RAILS_MASTER_KEY=
SECRET_KEY_BASE=

# Email Configuration (if using Action Mailer)
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH_METHOD=plain

# Application Settings
APP_HOST=localhost:3000
