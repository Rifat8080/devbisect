<!-- Hero Section -->
<div class="hero min-h-[600px] bg-gradient-to-r from-primary to-secondary">
  <div class="hero-content text-center text-primary-content">
    <div class="max-w-4xl">
      <h1 class="text-5xl md:text-7xl font-bold mb-6">Welcome to Devbisect</h1>
      <p class="text-xl md:text-2xl mb-8">Build amazing applications with Rails 8, Tailwind CSS, and modern UI components</p>
      <div class="flex gap-4 justify-center flex-wrap">
        <% if user_signed_in? %>
          <%= link_to "Go to Dashboard", dashboard_path, class: "btn btn-lg btn-neutral" %>
        <% else %>
          <%= link_to "Get Started", new_user_registration_path, class: "btn btn-lg btn-neutral" %>
          <%= link_to "Sign In", new_user_session_path, class: "btn btn-lg btn-outline btn-neutral" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<!-- Features Section -->
<div class="py-20 px-6 bg-base-100">
