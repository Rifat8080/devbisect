<!DOCTYPE html>
<html data-theme="light" class="scroll-smooth" id="top">
  <head>
    <title><%= content_for(:title) || "DevBisect - Digital Agency | Software Development, Branding & Design" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || 'DevBisect delivers complete digital solutions for businesses of all sizes. Expert software development, branding, graphics design, video editing, and content creation services.' %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "inter-font" %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="flowbite" class="antialiased">
    <% if current_page?(root_path) %>
      <!-- Homepage Navigation -->
      <nav class="bg-white/90 backdrop-blur-xl border-b border-blue-100 fixed w-full z-50 shadow-sm">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-between h-[76px]">
          
          <!-- Logo -->
          <div class="flex-shrink-0">
            <%= link_to root_path, class: "flex items-center space-x-3 group" do %>
              <div class="relative w-8 h-8">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="9" height="9" rx="1.5" fill="#1E40AF"/>
                  <rect x="13" y="2" width="9" height="9" rx="1.5" fill="#3B82F6"/>
                  <rect x="2" y="13" width="9" height="9" rx="1.5" fill="#2563EB"/>
                  <rect x="13" y="13" width="9" height="9" rx="1.5" fill="#60A5FA"/>
                </svg>
              </div>
              <span class="text-2xl font-semibold tracking-[-0.01em] text-gray-900">DevBisect</span>
            <% end %>
          </div>

          <!-- Desktop Navigation - Centered -->
          <div class="hidden lg:flex items-center justify-center flex-1">
            <div class="flex items-center space-x-3">
              <!-- Home -->
              <%= link_to root_path, class: "px-4 py-2.5 rounded-xl text-base font-semibold text-blue-700 bg-blue-50 hover:bg-blue-100 hover:text-blue-800 transition-all duration-200" do %>
                Home
              <% end %>
              
              <!-- Pages Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-1 px-4 py-2.5 rounded-xl text-base font-semibold text-gray-800 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200">
                  <span>Company</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white/95 backdrop-blur-md rounded-xl shadow-xl border border-blue-100 py-2">
                    <%= link_to root_path(anchor: "about"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      About Us
                    <% end %>
                    <%= link_to root_path(anchor: "process"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Our Process
                    <% end %>
                    <%= link_to root_path(anchor: "faqs"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      FAQs
                    <% end %>
                  </div>
                </div>
              </div>

              <!-- Services Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-1 px-4 py-2.5 rounded-xl text-base font-semibold text-gray-800 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200">
                  <span>Services</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white/95 backdrop-blur-md rounded-xl shadow-xl border border-blue-100 py-2">
                    <%= link_to root_path(anchor: "services"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Software Development
                    <% end %>
                    <%= link_to root_path(anchor: "services"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Branding
                    <% end %>
                    <%= link_to root_path(anchor: "services"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Graphics Design
                    <% end %>
                    <%= link_to root_path(anchor: "services"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Video Editing
                    <% end %>
                    <%= link_to root_path(anchor: "services"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Content Creation
                    <% end %>
                  </div>
                </div>
              </div>

              <!-- Projects Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-1 px-4 py-2.5 rounded-xl text-base font-semibold text-gray-800 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200">
                  <span>Portfolio</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white/95 backdrop-blur-md rounded-xl shadow-xl border border-blue-100 py-2">
                    <%= link_to root_path(anchor: "process"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      All Projects
                    <% end %>
                    <%= link_to root_path(anchor: "testimonials"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Case Studies
                    <% end %>
                    <%= link_to root_path(anchor: "testimonials"), class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Success Stories
                    <% end %>
                  </div>
                </div>
              </div>

              <!-- Blog -->
              <%= link_to root_path(anchor: "blog"), class: "px-4 py-2.5 rounded-xl text-base font-semibold text-gray-800 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200" do %>
                Blog
              <% end %>

              <!-- Contact -->
              <%= link_to root_path(anchor: "contact"), class: "px-4 py-2.5 rounded-xl text-base font-semibold text-gray-800 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200" do %>
                Contact
              <% end %>
            </div>
          </div>

          <!-- Right Side Actions -->
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <!-- User Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-2 px-3 py-2 text-sm font-medium text-gray-700 hover:text-blue-600 transition-colors duration-200 rounded-lg hover:bg-gray-50">
                  <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center text-xs font-semibold">
                    <%= current_user.email.first.upcase %>
                  </div>
                </button>
                <div class="absolute right-0 mt-2 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    <%= link_to dashboard_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Dashboard
                    <% end %>
                    <%= link_to edit_user_registration_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Profile
                    <% end %>
                    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-blue-50 hover:text-blue-600 transition-colors" do %>
                      Sign Out
                    <% end %>
                  </div>
                </div>
              </div>
            <% else %>
              <!-- Get Started Button -->
              <div class="flex items-center space-x-3">
                <%= link_to new_user_registration_path, class: "hidden lg:inline-flex items-center px-8 py-3 text-white text-base font-semibold rounded-2xl transition-all duration-200 shadow-[0_10px_24px_rgba(37,99,235,0.28)] hover:shadow-[0_14px_30px_rgba(37,99,235,0.35)] bg-gradient-to-r from-blue-800 to-blue-400" do %>
                  Start Your Project
                <% end %>
                
                <!-- Bot Icon -->
                <button class="flex h-12 w-12 items-center justify-center rounded-full border border-blue-200 bg-blue-50 text-blue-600 transition-all duration-200 hover:bg-blue-100 hover:scale-105">
                  <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect x="6" y="8" width="12" height="9" rx="3" stroke-width="2"/>
                    <path d="M12 5v3M9.5 12h.01M14.5 12h.01" stroke-linecap="round" stroke-width="2"/>
                  </svg>
                </button>
              </div>
            <% end %>

            <!-- Mobile Menu Button -->
            <button class="lg:hidden p-2.5 hover:bg-blue-50 rounded-xl transition-colors duration-200" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
              <svg class="w-7 h-7 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden lg:hidden pb-4">
          <div class="flex flex-col space-y-2">
            <%= link_to "Home", root_path, class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
            <%= link_to "Services", root_path(anchor: "services"), class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
            <%= link_to "Company", root_path(anchor: "about"), class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
            <%= link_to "Portfolio", root_path(anchor: "process"), class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
            <%= link_to "Blog", root_path(anchor: "blog"), class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
            <%= link_to "Contact", root_path(anchor: "contact"), class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
            <% unless user_signed_in? %>
                <%= link_to "Start Your Project", new_user_registration_path, class: "px-4 py-2 text-base font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg text-center" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>
    <% else %>
      <!-- Other Pages Navigation -->
      <nav class="bg-white/95 backdrop-blur-md border-b border-gray-200 fixed w-full z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex items-center justify-between h-20">
            
            <!-- Logo -->
            <div class="flex-shrink-0">
              <%= link_to root_path, class: "flex items-center space-x-3 group" do %>
                <div class="relative w-8 h-8">
                  <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="2" width="9" height="9" rx="1.5" fill="#1E40AF"/>
                    <rect x="13" y="2" width="9" height="9" rx="1.5" fill="#3B82F6"/>
                    <rect x="2" y="13" width="9" height="9" rx="1.5" fill="#2563EB"/>
                    <rect x="13" y="13" width="9" height="9" rx="1.5" fill="#60A5FA"/>
                  </svg>
                </div>
                <span class="text-2xl font-bold tracking-tight text-gray-900">DevBisect</span>
              <% end %>
            </div>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex items-center space-x-3">
              <%= link_to "Services", root_path(anchor: "services"), class: "px-4 py-2.5 rounded-xl text-base font-semibold text-gray-700 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200" %>
              <%= link_to "Portfolio", root_path(anchor: "process"), class: "px-4 py-2.5 rounded-xl text-base font-semibold text-gray-700 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200" %>
              <%= link_to "About", root_path(anchor: "about"), class: "px-4 py-2.5 rounded-xl text-base font-semibold text-gray-700 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200" %>
              <%= link_to "Blog", root_path(anchor: "blog"), class: "px-4 py-2.5 rounded-xl text-base font-semibold text-gray-700 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200" %>
              <%= link_to "Contact", root_path(anchor: "contact"), class: "px-4 py-2.5 rounded-xl text-base font-semibold text-gray-700 hover:text-blue-700 hover:bg-blue-50 transition-all duration-200" %>
            </div>

            <!-- Right Side Actions -->
            <div class="flex items-center space-x-4">
              <% if user_signed_in? %>
                <%= link_to dashboard_path, class: "hidden md:inline-flex items-center px-6 py-2.5 text-base font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-colors" do %>
                  Dashboard
                <% end %>
              <% else %>
                <%= link_to new_user_registration_path, class: "hidden md:inline-flex items-center px-6 py-2.5 text-base font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-xl transition-colors" do %>
                  Get Started
                <% end %>
              <% end %>

              <!-- Mobile Menu Button -->
              <button class="md:hidden p-2.5 hover:bg-blue-50 rounded-xl transition-colors" onclick="document.getElementById('other-mobile-menu').classList.toggle('hidden')">
                <svg class="w-7 h-7 text-gray-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Mobile Menu -->
          <div id="other-mobile-menu" class="hidden md:hidden pb-4 border-t border-gray-100 mt-2 pt-4">
            <div class="flex flex-col space-y-2">
              <%= link_to "Services", root_path(anchor: "services"), class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
              <%= link_to "Portfolio", root_path(anchor: "process"), class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
              <%= link_to "About", root_path(anchor: "about"), class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
              <%= link_to "Blog", root_path(anchor: "blog"), class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
              <%= link_to "Contact", root_path(anchor: "contact"), class: "px-4 py-2 text-base font-semibold text-gray-700 hover:bg-gray-50 rounded-lg" %>
              <% unless user_signed_in? %>
                <%= link_to "Get Started", new_user_registration_path, class: "px-4 py-2 text-base font-semibold text-white bg-blue-600 hover:bg-blue-700 rounded-lg text-center" %>
              <% end %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <!-- Flash Messages -->
    <% if notice || alert %>
      <div class="fixed top-20 right-4 z-50 space-y-2">
        <% if notice %>
          <div class="alert alert-success shadow-lg max-w-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span><%= notice %></span>
          </div>
        <% end %>

        <% if alert %>
          <div class="alert alert-error shadow-lg max-w-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m2 2l-2-2m0 0l2-2m-2 2l-2 2" /></svg>
            <span><%= alert %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="<%= current_page?(root_path) ? 'pt-16' : 'pt-16' %>">
      <%= yield %>
    </main>

    <footer class="bg-gradient-to-br from-gray-900 via-gray-800 to-gray-900 text-gray-300 <%= current_page?(root_path) ? '' : 'mt-20' %>">
      <div class="max-w-7xl mx-auto px-6 py-14 sm:py-16">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
          <div>
            <div class="flex items-center space-x-2 mb-4">
              <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2" y="2" width="9" height="9" rx="1.5" class="fill-blue-800"/>
                <rect x="13" y="2" width="9" height="9" rx="1.5" class="fill-blue-500"/>
                <rect x="2" y="13" width="9" height="9" rx="1.5" class="fill-blue-600"/>
                <rect x="13" y="13" width="9" height="9" rx="1.5" class="fill-blue-400"/>
              </svg>
              <span class="text-xl font-bold text-white">DevBisect</span>
            </div>
            <p class="text-sm text-gray-400 mb-5">Transforming digital visions into reality.</p>
            <div class="flex items-center gap-4">
              <a href="#" class="text-gray-400 hover:text-blue-300 transition-colors" aria-label="Twitter">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
              </a>
              <a href="#" class="text-gray-400 hover:text-blue-300 transition-colors" aria-label="Facebook">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
              </a>
              <a href="#" class="text-gray-400 hover:text-blue-300 transition-colors" aria-label="Instagram">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
