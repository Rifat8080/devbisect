    <div class="flex gap-4 justify-center flex-wrap">
      <% if user_signed_in? %>
        <%= link_to "Go to Dashboard", dashboard_path, class: "btn btn-lg btn-primary" %>
      <% else %>
        <%= link_to "Get Started Free", new_user_registration_path, class: "btn btn-lg btn-primary" %>
        <%= link_to "View Demo", "#", class: "btn btn-lg btn-outline" %>
      <% end %>
    </div>
  </div>
</div>
