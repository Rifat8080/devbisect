<!DOCTYPE html>
<html data-theme="light">
  <head>
    <title><%= content_for(:title) || "DevBisect - Digital Agency | Software Development, Branding & Design" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= content_for(:description) || 'DevBisect delivers complete digital solutions for businesses of all sizes. Expert software development, branding, graphics design, video editing, and content creation services.' %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "tailwind", "inter-font" %>
    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body data-controller="flowbite" class="antialiased">
    <% if current_page?(root_path) %>
      <!-- Homepage Navigation -->
      <nav class="bg-[#F4F2FD]/95 backdrop-blur-sm border-b border-gray-200 fixed w-full z-50">
      <div class="max-w-7xl mx-auto px-6">
        <div class="flex items-center justify-between h-[62px]">
          
          <!-- Logo -->
          <div class="flex-shrink-0">
            <%= link_to root_path, class: "flex items-center space-x-2.5 group" do %>
              <div class="relative w-7 h-7">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="9" height="9" rx="1.5" fill="#8B5CF6"/>
                  <rect x="13" y="2" width="9" height="9" rx="1.5" fill="#A78BFA"/>
                  <rect x="2" y="13" width="9" height="9" rx="1.5" fill="#6366F1"/>
                  <rect x="13" y="13" width="9" height="9" rx="1.5" fill="#818CF8"/>
                </svg>
              </div>
              <span class="text-lg font-semibold tracking-[-0.01em] text-gray-900">DevBisect</span>
            <% end %>
          </div>

          <!-- Desktop Navigation - Centered -->
          <div class="hidden lg:flex items-center justify-center flex-1">
            <div class="flex items-center space-x-6">
              <!-- Home -->
              <%= link_to root_path, class: "px-2 py-2 text-[13px] font-medium text-indigo-600 hover:text-indigo-700 transition-colors duration-200" do %>
                Home
              <% end %>
              
              <!-- Pages Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-1 px-2 py-2 text-[13px] font-medium text-gray-800 hover:text-gray-900 transition-colors duration-200">
                  <span>Company</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">About Us</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Our Team</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Careers</a>
                  </div>
                </div>
              </div>

              <!-- Services Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-1 px-2 py-2 text-[13px] font-medium text-gray-800 hover:text-gray-900 transition-colors duration-200">
                  <span>Services</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    <a href="#services" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Software Development</a>
                    <a href="#services" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Branding</a>
                    <a href="#services" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Graphics Design</a>
                    <a href="#services" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Video Editing</a>
                    <a href="#services" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Content Creation</a>
                  </div>
                </div>
              </div>

              <!-- Projects Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-1 px-2 py-2 text-[13px] font-medium text-gray-800 hover:text-gray-900 transition-colors duration-200">
                  <span>Portfolio</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
                <div class="absolute left-0 mt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">All Projects</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Case Studies</a>
                    <a href="#" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors">Success Stories</a>
                  </div>
                </div>
              </div>

              <!-- Blog -->
              <a href="#" class="px-2 py-2 text-[13px] font-medium text-gray-800 hover:text-gray-900 transition-colors duration-200">Blog</a>

              <!-- Contact -->
              <a href="#contact" class="px-2 py-2 text-[13px] font-medium text-gray-800 hover:text-gray-900 transition-colors duration-200">Contact</a>
            </div>
          </div>

          <!-- Right Side Actions -->
          <div class="flex items-center space-x-4">
            <% if user_signed_in? %>
              <!-- User Dropdown -->
              <div class="relative group">
                <button class="flex items-center space-x-2 px-3 py-2 text-sm font-medium text-gray-700 hover:text-indigo-600 transition-colors duration-200 rounded-lg hover:bg-gray-50">
                  <div class="w-8 h-8 rounded-full bg-indigo-600 text-white flex items-center justify-center text-xs font-semibold">
                    <%= current_user.email.first.upcase %>
                  </div>
                </button>
                <div class="absolute right-0 mt-2 w-48 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 transform group-hover:translate-y-0 translate-y-2">
                  <div class="bg-white rounded-lg shadow-lg border border-gray-100 py-2">
                    <%= link_to dashboard_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" do %>
                      Dashboard
                    <% end %>
                    <%= link_to edit_user_registration_path, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" do %>
                      Profile
                    <% end %>
                    <%= link_to destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-4 py-2.5 text-sm text-gray-700 hover:bg-indigo-50 hover:text-indigo-600 transition-colors" do %>
                      Sign Out
                    <% end %>
                  </div>
                </div>
              </div>
            <% else %>
              <!-- Get Started Button -->
              <div class="flex items-center space-x-3">
                <%= link_to new_user_registration_path, class: "hidden lg:inline-flex items-center px-7 py-2.5 text-white text-sm font-semibold rounded-xl transition-all duration-200 shadow-[0_8px_20px_rgba(99,102,241,0.25)]", style: "background: linear-gradient(90deg, #8B5CF6 0%, #60A5FA 100%);" do %>
                  Start Your Project
                <% end %>
                
                <!-- Bot Icon -->
                <button class="flex h-10 w-10 items-center justify-center rounded-full border border-indigo-200 bg-[#F4F2FD] text-indigo-500 transition-colors duration-200 hover:bg-white">
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <rect x="6" y="8" width="12" height="9" rx="3" stroke-width="2"/>
                    <path d="M12 5v3M9.5 12h.01M14.5 12h.01" stroke-linecap="round" stroke-width="2"/>
                  </svg>
                </button>
              </div>
            <% end %>

            <!-- Mobile Menu Button -->
            <button class="lg:hidden p-2 hover:bg-gray-100 rounded-lg transition-colors duration-200" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
              <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden lg:hidden pb-4">
          <div class="flex flex-col space-y-2">
            <%= link_to "Home", root_path, class: "px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg" %>
            <a href="#services" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Services</a>
            <a href="#" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Company</a>
            <a href="#" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Portfolio</a>
            <a href="#" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Blog</a>
            <a href="#contact" class="px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg">Contact</a>
            <% unless user_signed_in? %>
              <%= link_to "Start Your Project", new_user_registration_path, class: "px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg text-center" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>
    <% else %>
      <!-- Other Pages Navigation -->
      <nav class="bg-white border-b border-gray-200 fixed w-full z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex items-center justify-between h-16">
            
            <!-- Logo -->
            <div class="flex-shrink-0">
              <%= link_to root_path, class: "flex items-center space-x-2.5 group" do %>
                <div class="relative w-7 h-7">
                  <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none">
                    <rect x="2" y="2" width="9" height="9" rx="1.5" fill="#8B5CF6"/>
                    <rect x="13" y="2" width="9" height="9" rx="1.5" fill="#A78BFA"/>
                    <rect x="2" y="13" width="9" height="9" rx="1.5" fill="#6366F1"/>
                    <rect x="13" y="13" width="9" height="9" rx="1.5" fill="#818CF8"/>
                  </svg>
                </div>
                <span class="text-lg font-bold tracking-tight text-gray-900">DevBisect</span>
              <% end %>
            </div>

            <!-- Desktop Navigation -->
            <div class="hidden md:flex items-center space-x-8">
              <%= link_to "Services", "#services", class: "text-sm font-medium text-gray-700 hover:text-indigo-600 transition-colors" %>
              <%= link_to "Portfolio", "#", class: "text-sm font-medium text-gray-700 hover:text-indigo-600 transition-colors" %>
              <%= link_to "About", "#", class: "text-sm font-medium text-gray-700 hover:text-indigo-600 transition-colors" %>
              <%= link_to "Blog", "#", class: "text-sm font-medium text-gray-700 hover:text-indigo-600 transition-colors" %>
              <%= link_to "Contact", "#contact", class: "text-sm font-medium text-gray-700 hover:text-indigo-600 transition-colors" %>
            </div>

            <!-- Right Side Actions -->
            <div class="flex items-center space-x-4">
              <% if user_signed_in? %>
                <%= link_to dashboard_path, class: "hidden md:inline-flex items-center px-5 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors" do %>
                  Dashboard
                <% end %>
              <% else %>
                <%= link_to new_user_registration_path, class: "hidden md:inline-flex items-center px-5 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg transition-colors" do %>
                  Get Started
                <% end %>
              <% end %>

              <!-- Mobile Menu Button -->
              <button class="md:hidden p-2 hover:bg-gray-100 rounded-lg transition-colors" onclick="document.getElementById('other-mobile-menu').classList.toggle('hidden')">
                <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Mobile Menu -->
          <div id="other-mobile-menu" class="hidden md:hidden pb-4 border-t border-gray-100 mt-2 pt-4">
            <div class="flex flex-col space-y-2">
              <%= link_to "Services", "#services", class: "px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg" %>
              <%= link_to "Portfolio", "#", class: "px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg" %>
              <%= link_to "About", "#", class: "px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg" %>
              <%= link_to "Blog", "#", class: "px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg" %>
              <%= link_to "Contact", "#contact", class: "px-4 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 rounded-lg" %>
              <% unless user_signed_in? %>
                <%= link_to "Get Started", new_user_registration_path, class: "px-4 py-2 text-sm font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg text-center" %>
              <% end %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <!-- Flash Messages -->
    <% if notice || alert %>
      <div class="fixed top-20 right-4 z-50 space-y-2">
        <% if notice %>
          <div class="alert alert-success shadow-lg max-w-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span><%= notice %></span>
          </div>
        <% end %>

        <% if alert %>
          <div class="alert alert-error shadow-lg max-w-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current flex-shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m2 2l-2-2m0 0l2-2m-2 2l-2 2" /></svg>
            <span><%= alert %></span>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Main Content -->
    <main class="<%= current_page?(root_path) ? 'pt-16' : 'pt-16' %>">
      <%= yield %>
    </main>

    <% if current_page?(root_path) %>
      <!-- Homepage Footer -->
      <footer class="bg-gray-900 text-gray-300">
        <div class="max-w-7xl mx-auto px-6 py-12">
          <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
            <!-- Brand Column -->
            <div class="md:col-span-1">
              <div class="flex items-center space-x-2 mb-4">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none">
                  <rect x="2" y="2" width="9" height="9" rx="1.5" fill="#8B5CF6"/>
                  <rect x="13" y="2" width="9" height="9" rx="1.5" fill="#A78BFA"/>
                  <rect x="2" y="13" width="9" height="9" rx="1.5" fill="#6366F1"/>
                  <rect x="13" y="13" width="9" height="9" rx="1.5" fill="#818CF8"/>
                </svg>
                <span class="text-xl font-bold text-white">DevBisect</span>
              </div>
              <p class="text-sm text-gray-400 mb-4">Transforming digital visions into reality.</p>
              <div class="flex space-x-4">
                <a href="#" class="text-gray-400 hover:text-white transition-colors">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 4.557c-.883.392-1.832.656-2.828.775 1.017-.609 1.798-1.574 2.165-2.724-.951.564-2.005.974-3.127 1.195-.897-.957-2.178-1.555-3.594-1.555-3.179 0-5.515 2.966-4.797 6.045-4.091-.205-7.719-2.165-10.148-5.144-1.29 2.213-.669 5.108 1.523 6.574-.806-.026-1.566-.247-2.229-.616-.054 2.281 1.581 4.415 3.949 4.89-.693.188-1.452.232-2.224.084.626 1.956 2.444 3.379 4.6 3.419-2.07 1.623-4.678 2.348-7.29 2.04 2.179 1.397 4.768 2.212 7.548 2.212 9.142 0 14.307-7.721 13.995-14.646.962-.695 1.797-1.562 2.457-2.549z"/></svg>
                </a>
                <a href="#" class="text-gray-400 hover:text-white transition-colors">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
                </a>
                <a href="#" class="text-gray-400 hover:text-white transition-colors">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                </a>
                <a href="#" class="text-gray-400 hover:text-white transition-colors">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
                </a>
              </div>
            </div>

            <!-- Services Column -->
            <div>
              <h3 class="text-white font-semibold mb-4">Services</h3>
              <ul class="space-y-2 text-sm">
                <li><a href="#services" class="text-gray-400 hover:text-white transition-colors">Software Development</a></li>
                <li><a href="#services" class="text-gray-400 hover:text-white transition-colors">Branding</a></li>
                <li><a href="#services" class="text-gray-400 hover:text-white transition-colors">Logo Design</a></li>
                <li><a href="#services" class="text-gray-400 hover:text-white transition-colors">Graphics Design</a></li>
                <li><a href="#services" class="text-gray-400 hover:text-white transition-colors">Video Editing</a></li>
              </ul>
            </div>

            <!-- Company Column -->
            <div>
              <h3 class="text-white font-semibold mb-4">Company</h3>
              <ul class="space-y-2 text-sm">
                <li><a href="#" class="text-gray-400 hover:text-white transition-colors">About Us</a></li>
                <li><a href="#" class="text-gray-400 hover:text-white transition-colors">Our Team</a></li>
                <li><a href="#" class="text-gray-400 hover:text-white transition-colors">Careers</a></li>
                <li><a href="#" class="text-gray-400 hover:text-white transition-colors">Contact</a></li>
                <li><a href="#" class="text-gray-400 hover:text-white transition-colors">Blog</a></li>
              </ul>
            </div>

            <!-- Legal Column -->
            <div>
